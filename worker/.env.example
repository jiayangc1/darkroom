SERVER_URL=https://darkroom.example.com
WORKER_TOKEN=
# Memory: only take a job when at least this much is available; ~GB_PER_TAB per Chrome tab, up to MAX_TABS
MIN_FREE_GB=8
GB_PER_TAB=2
MAX_TABS=4
# Don't take jobs during these local-time windows, e.g. 09:00-18:00,22:00-02:00
PAUSE_SCHEDULE=
# After critical memory pressure, wait this long before taking another job
PRESSURE_COOLDOWN_SEC=300
# CHROME_GL=angle
