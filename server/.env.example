PORT=3000
DATABASE_URL=postgres://darkroom:darkroom@localhost:5432/darkroom
PUBLIC_BASE_URL=https://darkroom.example.com
# Number of reverse-proxy hops in front of the app (Coolify/Traefik = 1)
TRUST_PROXY=1
UPLOAD_DIR=/tmp/darkroom-uploads

BUNNY_STORAGE_ZONE=darkroom
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=la.storage.bunnycdn.com
# Pull zone serving the storage zone, e.g. https://darkroom.b-cdn.net
BUNNY_CDN_BASE=

# Optional overrides (defaults shown)
# LIMIT_BUNDLE_MAX_BYTES=524288000
# LIMIT_MAX_DURATION_SEC=600
# LIMIT_MAX_ACTIVE_JOBS=5
# LIMIT_REQUESTS_PER_MINUTE=60
# OUTPUT_RETENTION_DAYS=7
# EGRESS_ALLOWLIST=fonts.googleapis.com,fonts.gstatic.com,cdn.jsdelivr.net,unpkg.com,cdnjs.cloudflare.com
